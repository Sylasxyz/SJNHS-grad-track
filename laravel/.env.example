APP_NAME="SJNHS Graduate Tracking System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8011
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Existing schema; no Laravel migrations. On Railway the MYSQL* variables are used instead.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=graduate_tracking
DB_USERNAME=root
DB_PASSWORD=

# No sessions/cache/jobs tables in the schema.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="gradtrack.sjnhs@gmail.com"
MAIL_FROM_NAME="San Josef NHS Graduate Tracking"

# Outbound email goes through the Brevo HTTPS API (key starts with xkeysib-).
BREVO_API_KEY=
MAIL_FROM_EMAIL=gradtrack.sjnhs@gmail.com
MAIL_ALWAYS_LOG=true
# Show the reset code on screen when email fails (never enable in production).
MAIL_SHOW_RESET_LINK_ON_FAILURE=false

# Folder holding uploads/ (defaults to the project root, one level above laravel/).
# UPLOADS_ROOT=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
