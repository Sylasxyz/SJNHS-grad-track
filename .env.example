# Copy to .env for local docker-compose (optional). Railway: set these in the service Variables tab.

# --- App ---
APP_DEBUG=1

# --- Database (XAMPP defaults) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=graduate_tracking
DB_USER=root
DB_PASS=

# Railway MySQL plugin (auto-injected when linked — names may vary):
# MYSQLHOST=
# MYSQLPORT=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=
# DATABASE_URL=mysql://user:pass@host:port/dbname

# --- Mail (Gmail SMTP) ---
SMTP_ENABLED=1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=gradtrack.sjnhs@gmail.com
SMTP_PASS=
MAIL_FROM_EMAIL=gradtrack.sjnhs@gmail.com
MAIL_FROM_NAME=San Josef NHS Graduate Tracking
MAIL_ALWAYS_LOG=1
MAIL_SHOW_RESET_LINK_ON_FAILURE=0
